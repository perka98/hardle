{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/server/:path*",
      "destination": "/api/private-resource"
    },
    {
      "source": "/supabase/:path*",
      "destination": "/api/private-resource"
    },
    {
      "source": "/tests/:path*",
      "destination": "/api/private-resource"
    },
    {
      "source": "/artist",
      "destination": "/artist.html"
    },
    {
      "source": "/daily",
      "destination": "/daily.html"
    },
    {
      "source": "/djdle",
      "destination": "/djdle.html"
    },
    {
      "source": "/orderdle",
      "destination": "/orderdle.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    }
  ],
  "functions": {
    "api/game-session.js": {
      "includeFiles": "server/private/**"
    }
  }
}
