{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/artist",
      "destination": "/artist.html"
    },
    {
      "source": "/daily",
      "destination": "/daily.html"
    },
    {
      "source": "/djdle",
      "destination": "/djdle.html"
    }
  ]
}
