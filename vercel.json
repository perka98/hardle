{
  "functions": {
    "api/game-session.js": {
      "includeFiles": "server/private/**"
    },
    "api/preview-game.js": {
      "includeFiles": "server/private/**"
    }
  },
  "regions": [
    "arn1"
  ],
  "routes": [
    {
      "src": "^/(server|supabase|tests|checks)(/.*)?$",
      "dest": "/api/private-resource"
    },
    {
      "src": "/.*",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/artist$",
      "dest": "/artist.html"
    },
    {
      "src": "^/daily$",
      "dest": "/daily.html"
    },
    {
      "src": "^/djdle$",
      "dest": "/djdle.html"
    },
    {
      "src": "^/orderdle$",
      "dest": "/orderdle.html"
    },
    {
      "src": "^/account$",
      "dest": "/account.html"
    },
    {
      "src": "^/leaderboard$",
      "dest": "/leaderboard.html"
    }
  ]
}
